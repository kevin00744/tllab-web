# TL Lab Hub 網頁設定（複製為 .env 後填入）

# 網頁對外網址
NEXT_PUBLIC_SITE_URL=https://hub.example.edu.tw

# Supabase API 網址與金鑰
#   Supabase Cloud：Project Settings → API
#   自架 Supabase：SUPABASE_PUBLIC_URL 與 ANON_KEY / SERVICE_ROLE_KEY（Supabase docker/.env）
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.edu.tw
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 僅伺服器端使用（例如 Admin 管理成員帳號），不可外流
SUPABASE_SERVICE_ROLE_KEY=
